    <rulePack>
      <rulesStrings>
        <!-- Adepta Sororitas Specific Content -->
        <li>r_ideoName(p=6)->[holyAdjective] [creed]</li>
        <li>r_ideoName(p=3)->[faithAdjective] [creed]</li>
        <li>r_ideoName(p=1)->[holyAdjective] [sororitasNoun]</li>
