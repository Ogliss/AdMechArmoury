<RulePackDef>
  <defName>OG_FestivalNamer_Sororitas</defName>
  <rulePack>
    <rulesStrings>
      <!-- Festival Name Patterns -->
      <li>festivalName(p=2)->[holyAdjective] [festival]</li>
      <li>festivalName->[festival] of [faithAspect]</li>
      <li>festivalName->[faithAdjective] [festival]</li>
      <li>festivalName->[saintName]'s [festival]</li>
      <li>festivalName->[festival] of [saintName]</li>
      <li>festivalName->[festival] of [faithConcept]</li>
      <li>festivalName->[festival] of [convent]</li>

      <!-- Festival Synonyms -->
      <li>festival->festival</li>
      <li>festival->celebration</li>
      <li>festival->rite</li>
      <li>festival->conclave</li>
      <li>festival->ceremony</li>
      <li>festival->jubilee</li>

      <!-- Adjectives and Themes -->
      <li>holyAdjective->Holy</li>
      <li>holyAdjective->Sacred</li>
      <li>holyAdjective->Divine</li>
      <li>holyAdjective->Blessed</li>
      <li>holyAdjective->Righteous</li>

      <li>faithAdjective->Zealous</li>
      <li>faithAdjective->Pious</li>
      <li>faithAdjective->Devout</li>
      <li>faithAdjective->Fervent</li>
      <li>faithAdjective->Martyr</li>

      <li>saintName->Celestine</li>
      <li>saintName->Katherine</li>
      <li>saintName->Lucia</li>
      <li>saintName->Arabella</li>
      <li>saintName->Dominica</li>

      <li>faithConcept->Faith</li>
      <li>faithConcept->Sacrifice</li>
      <li>faithConcept->Martyrdom</li>
      <li>faithConcept->Purity</li>
      <li>faithConcept->Virtue</li>

      <li>convent->Sanctorum</li>
      <li>convent->Prioris</li>
      <li>convent->Argent Shroud</li>
      <li>convent->Ebon Chalice</li>
      <li>convent->Valorous Heart</li>
    </rulesStrings>
  </rulePack>
</RulePackDef>

<RulePackDef>
