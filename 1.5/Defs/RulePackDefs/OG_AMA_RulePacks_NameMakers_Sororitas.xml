  </include>
  <rulePack>
    <rulesStrings>
      <!-- Leader Title Patterns -->
      <li>r_leaderTitle(p=6)->[holyAdjective] [sororitasTitle]</li>
      <li>r_leaderTitle(p=3)->[faithAdjective] [sororitasTitle]</li>
      <li>r_leaderTitle(p=1)->[holyAdjective] [sororitasNoun]</li>
      <li>r_leaderTitle(p=1)->[sororitasNoun]</li>

      <!-- Adjectives and Titles -->
      <li>holyAdjective->Holy</li>
      <li>holyAdjective->Sacred</li>
      <li>holyAdjective->Divine</li>
      <li>holyAdjective->Blessed</li>
      <li>holyAdjective->Righteous</li>

      <li>faithAdjective->Zealous</li>
      <li>faithAdjective->Pious</li>
      <li>faithAdjective->Devout</li>
      <li>faithAdjective->Fervent</li>
      <li>faithAdjective->Martyr</li>

      <li>sororitasTitle->Canoness</li>
