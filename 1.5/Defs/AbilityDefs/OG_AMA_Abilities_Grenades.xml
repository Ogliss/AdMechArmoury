<?xml version="1.0" encoding="utf-8" ?>

<Defs>

<!-- ======================== Tau - Photon Grenade Launcher Ability ================================== -->
	<ThingDef ParentName="BaseGrenadeProjectile">
		<defName>OGT_GrenadeLaunched_Photon</defName>
		<graphicData>
			<texPath>Things/Projectile/TauPhotonGrenade</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>OGGrenadePhoton</damageDef>
			<damageAmountBase>1</damageAmountBase>
			<armorPenetrationBase>1</armorPenetrationBase>
			<explosionRadius>3</explosionRadius>
			<explosionDelay>20</explosionDelay>
			<speed>35</speed>
			<flyOverhead>false</flyOverhead>
		</projectile>
	</ThingDef>

	<AbilityDef>
        <defName>OGT_Ability_LaunchPhoton</defName>
        <label>Launch Photon</label>
        <iconPath>Things/Projectile/TauPhotonGrenade</iconPath>
        <description>Launches a Photon Grenade.</description>
        <!--abilityClass>AbilitesExtended.EquipmentAbility</abilityClass-->
		<cooldownTicksRange>300</cooldownTicksRange> <!-- 5 seconds -->
        <verbProperties Class="AbilitesExtended.VerbProperties_EquipmentAbility">
            <verbClass>AbilitesExtended.Verb_ShootEquipment</verbClass>
            <hasStandardCommand>true</hasStandardCommand>
			<ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
			<defaultProjectile>OGT_GrenadeLaunched_Photon</defaultProjectile>
            <warmupTime>0.4</warmupTime>
            <burstShotCount>1</burstShotCount>
            <ticksBetweenBurstShots>2</ticksBetweenBurstShots>
			<range>31</range>
			<forcedMissRadius>1.9</forcedMissRadius>
            <soundCast>ThrowGrenade</soundCast>
            <muzzleFlashScale>0</muzzleFlashScale>
            
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
        </verbProperties>
		<comps>
			<li Class="CompProperties_EffectWithDest">
			<compClass>AbilitesExtended.CompAbilityEffect_Shoot</compClass>
			<psychic>false</psychic>
			<goodwillImpact>0</goodwillImpact>
			<screenShakeIntensity>0</screenShakeIntensity>
			<clamorRadius>0</clamorRadius>
			</li>
		</comps>
	</AbilityDef>
 
