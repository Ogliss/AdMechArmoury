<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <MemeDef ParentName="OG_Structure_MemeBase">
    <defName>OG_Structure_Aeldari_Asuryani</defName>
    <label>craftworld eldar</label>
    <description>The Craftworld Eldar follow a strict path system, guided by their pantheon of gods. Their society is highly structured, with each individual dedicating themselves to a specific path to avoid the excesses that led to their fall. They revere gods such as Asuryan, Khaine, and Isha, and their culture is deeply rooted in maintaining their traditions and spiritual connections.</description>
    <category>Structure</category>
    <iconPath>Ui/Memes/Structure/CraftworldEldar</iconPath>
    <impact>0</impact>
    <deityCount>3</deityCount>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->Eldar</li>
        <li>memeHyphenPrefix->Path</li>
        <li>memeLeaderNoun->Farseer</li>
        <li>memeLeaderAdjective->Wise</li>
        <li>memeMoralist->Spiritseer</li>
        <li>memeMoralist->Warlock</li>
        <li>memeShootingSpecialist->Pathfinder</li>
        <li>memeMeleeSpecialist->Striking Scorpion</li>
        <li>memeResearchSpecialist->Bonesinger</li>
        <li>memePlantSpecialist->Ranger</li>
        <li>memeAnimalsSpecialist->Beastmaster</li>
        <li>memeProductionSpecialist->Artisan</li>
        <li>memeMiningSpecialist->Miner</li>
        <li>memeMedicalSpecialist->Healer</li>
      </rulesStrings>
    </generalRules>
    <descriptionMaker>
      <patterns>
        <li><def>OG_Aeldari_Asuryani_Myth</def></li>
        <li><def>OG_Aeldari_Asuryani_Founder</def></li>
      </patterns>
      <constants>
        <li><key>og_structure_aeldari_asuryani</key><value>true</value></li>
      </constants>
    </descriptionMaker>
    <worshipRoomLabel>temple</worshipRoomLabel>
    <symbolPacks>
      <li>
        <ideoName>Asuryan</ideoName>
        <theme>wisdom</theme>
        <adjective>wise</adjective>
        <member>seer</member>
      </li>
      <li>
        <ideoName>Khaine</ideoName>
        <theme>war</theme>
        <adjective>warlike</adjective>
        <member>warrior</member>
      </li>
      <li>
        <ideoName>Isha</ideoName>
        <theme>life</theme>
        <adjective>nurturing</adjective>
        <member>caretaker</member>
      </li>
    </symbolPacks>
    <preferredWeaponClasses>
      <noble>Ultratech</noble>
      <despised>Neolithic</despised>
    </preferredWeaponClasses>
    <!--requireOne>
      <li>
        <li>BodyMod_Abhorrent</li>
        <li>WorkDrive_Tripled</li>
        <li>PsychicRituals_Exalted</li>
        <li>Comfort_Ignored</li>
      </li>
    </requireOne-->
    <!--thingStyleCategories>
      <li>
        <category>Elegant</category>
        <priority>4</priority>
      </li>
    </thingStyleCategories-->
    <agreeableTraits>
      <PsychicSensitivity>1</PsychicSensitivity>
      <PsychicSensitivity>2</PsychicSensitivity>
      <BodyPurist>0</BodyPurist>
    </agreeableTraits>
    <disagreeableTraits>
      <PsychicSensitivity>-1</PsychicSensitivity>
      <PsychicSensitivity>-2</PsychicSensitivity>
      <Beauty>-1</Beauty>
      <Beauty>-2</Beauty>
    </disagreeableTraits>
</MemeDef>

<MemeDef ParentName="OG_Structure_MemeBase">
    <defName>OG_Structure_Aeldari_Exodites</defName>
    <label>exodites</label>
    <description>The Exodites are Eldar who rejected the hedonistic and decadent path that led to the Fall. They established remote colonies where they live in harmony with nature, guided by a belief in the spirits of their ancestors and the natural world. Their society is agrarian and deeply spiritual, valuing simplicity and balance.</description>
    <category>Structure</category>
    <iconPath>Ui/Memes/Structure/Exodites</iconPath>
    <impact>0</impact>
    <deityCount>0</deityCount>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->Exodite</li>
        <li>memeHyphenPrefix->Spirit</li>
        <li>memeLeaderNoun->Chieftain</li>
        <li>memeLeaderAdjective->Wise</li>
        <li>memeMoralist->Shaman</li>
        <li>memeMoralist->Seer</li>
        <li>memeShootingSpecialist->Pathfinder</li>
        <li>memeMeleeSpecialist->Beast Rider</li>
        <li>memeResearchSpecialist->Lorekeeper</li>
        <li>memePlantSpecialist->Farmer</li>
        <li>memeAnimalsSpecialist->Beastmaster</li>
        <li>memeProductionSpecialist->Craftsman</li>
        <li>memeMiningSpecialist->Miner</li>
        <li>memeMedicalSpecialist->Healer</li>
      </rulesStrings>
    </generalRules>
    <descriptionMaker>
      <patterns>
        <li><def>OG_Aeldari_Exodite_Myth</def></li>
        <li><def>OG_Aeldari_Exodite_Founder</def></li>
      </patterns>
      <constants>
        <li><key>og_structure_aeldari_exodites</key><value>true</value></li>
      </constants>
    </descriptionMaker>
    <worshipRoomLabel>shrine</worshipRoomLabel>
    <symbolPacks>
      <li>
        <ideoName>Harmony</ideoName>
        <theme>nature</theme>
        <adjective>harmonious</adjective>
        <member>guardian</member>
      </li>
      <li>
        <ideoName>Spirit</ideoName>
        <theme>spirituality</theme>
        <adjective>spiritual</adjective>
        <member>shaman</member>
      </li>
      <li>
        <ideoName>Balance</ideoName>
        <theme>balance</theme>
        <adjective>balanced</adjective>
        <member>keeper</member>
      </li>
    </symbolPacks>
    <preferredWeaponClasses>
      <noble>Melee</noble>
      <despised>Ranged</despised>
    </preferredWeaponClasses>
    <!--requireOne>
      <li>
        <li>PsychicSensitivity_Moderate</li>
      </li>
    </requireOne-->
    <!--thingStyleCategories>
      <li>
        <category>Natural</category>
        <priority>4</priority>
      </li>
    </thingStyleCategories-->
