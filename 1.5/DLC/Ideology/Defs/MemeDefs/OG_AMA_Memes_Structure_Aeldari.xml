      <PsychicSensitivity>1</PsychicSensitivity>
      <PsychicSensitivity>2</PsychicSensitivity>
      <GreenThumb>0</GreenThumb>
    </agreeableTraits>
    <disagreeableTraits>
      <PsychicSensitivity>-1</PsychicSensitivity>
      <PsychicSensitivity>-2</PsychicSensitivity>
      <Industriousness>2</Industriousness>
    </disagreeableTraits>
</MemeDef>

<MemeDef ParentName="OG_Structure_MemeBase">
    <defName>OG_Structure_Aeldari_Harlequin</defName>
    <label>Harlequin Masque</label>
    <description>Harlequins are followers of the Laughing God, Cegorach, and they express their devotion through both deadly combat and elaborate performances. Their creed includes spreading the myths and stories of their people through the Dance Without End, and using their agility and martial prowess to combat the forces of Chaos and protect the remnants of the Eldar race.</description>
    <category>Structure</category>
    <groupDef>Theist_Embodied</groupDef>
    <iconPath>Icons/Harlequin/Icon_Harlequin</iconPath>
    <impact>0</impact>
    <worshipRoomLabel>performance hall</worshipRoomLabel>
    <deityCount>1</deityCount>
    <generalRules>
      <rulesStrings>
        <li>memeCreed->troupe</li>
        <li>memeCreed->masque</li>
        <li>memeCreed->performance</li>
        <li>memeCreed->ritual</li>
        <li>memeHyphenPrefix->harle</li>
        <li>memeConcept->illusion</li>
        <li>memeConcept->trickery</li>
        <li>memeLeaderNoun->Troupe Master</li>
        <li>memeLeaderAdjective->deceptive</li>
        <li>memeMoralist->Shadowseer</li>
        <li>memeMoralist->Death Jester</li>
        <li>memeShootingSpecialist->Skyweaver</li>
        <li>memeMeleeSpecialist->Solitaire</li>
        <li>memeResearchSpecialist->Master of Myths</li>
        <li>memePlantSpecialist->Master of Harvests</li>
        <li>memeAnimalsSpecialist->Beastmaster</li>
        <li>memeProductionSpecialist->Master Artisan</li>
        <li>memeMiningSpecialist->Prospector</li>
        <li>memeMedicalSpecialist->Healer</li>
      </rulesStrings>
    </generalRules>
    <descriptionMaker>
      <patterns>
        <li><def>OG_Aeldari_Harlequin_Myth</def></li>
        <li><def>OG_Aeldari_Harlequin_Founder</def></li>
      </patterns>
      <constants>
        <li><key>og_structure_aeldari_harlequin_theist</key><value>true</value></li>
        <li><key>og_structure_aeldari_harlequin_theistembodied</key><value>true</value></li>
      </constants>
    </descriptionMaker>
    <symbolPacks>
      <li>
        <ideoName>Harlequin</ideoName>
        <theme>performance</theme>
        <adjective>performing</adjective>
        <member>player</member>
      </li>
      <li>
        <ideoName>Illusion</ideoName>
        <theme>illusion</theme>
        <adjective>illusionary</adjective>
        <member>illusionist</member>
      </li>
    </symbolPacks>
</MemeDef>

<MemeDef ParentName="OG_Structure_MemeBase">
    <defName>OG_Structure_Aeldari_Ynnari</defName>
    <label>ynnari</label>
    <description>The Ynnari are followers of Ynnead, the god of the dead, seeking to unite the Eldar factions and overthrow Slaanesh. Led by Yvraine, the Visarch, and the Yncarne, they harness the power of death to rejuvenate themselves and bolster their psychic abilities. The Ynnari believe in the rebirth of their race through the awakening of Ynnead, striving to free Eldar souls from the torment of the Warp.</description>
    <category>Structure</category>
    <iconPath>Ui/Memes/Structure/Ynnari</iconPath>
    <impact>0</impact>
    <deityCount>1</deityCount>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->Ynnari</li>
        <li>memeHyphenPrefix->Reborn</li>
        <li>memeLeaderNoun->Emissary</li>
        <li>memeLeaderAdjective->Resurrected</li>
        <li>memeMoralist->Spiritseer</li>
        <li>memeMoralist->Death Jester</li>
        <li>memeShootingSpecialist->Reaper</li>
        <li>memeMeleeSpecialist->Incubus</li>
        <li>memeResearchSpecialist->Lorekeeper</li>
        <li>memePlantSpecialist->Harvester</li>
        <li>memeAnimalsSpecialist->Beastmaster</li>
        <li>memeProductionSpecialist->Artisan</li>
        <li>memeMiningSpecialist->Soul Harvester</li>
        <li>memeMedicalSpecialist->Healer</li>
      </rulesStrings>
    </generalRules>
    <descriptionMaker>
      <patterns>
        <li><def>OG_Aeldari_Ynnari_Myth</def></li>
        <li><def>OG_Aeldari_Ynnari_Founder</def></li>
      </patterns>
      <constants>
        <li><key>og_structure_aeldari_ynnari</key><value>true</value></li>
      </constants>
    </descriptionMaker>
    <worshipRoomLabel>temple</worshipRoomLabel>
    <symbolPacks>
      <li>
        <ideoName>Rebirth</ideoName>
        <theme>resurrection</theme>
        <adjective>reborn</adjective>
        <member>resurrected</member>
      </li>
      <li>
        <ideoName>Death</ideoName>
        <theme>death</theme>
        <adjective>deathly</adjective>
        <member>deathbringer</member>
      </li>
      <li>
        <ideoName>Unity</ideoName>
        <theme>unity</theme>
        <adjective>unified</adjective>
        <member>unifier</member>
      </li>
    </symbolPacks>
    <preferredWeaponClasses>
      <noble>Ranged</noble>
      <despised>LongShots</despised>
    </preferredWeaponClasses>
