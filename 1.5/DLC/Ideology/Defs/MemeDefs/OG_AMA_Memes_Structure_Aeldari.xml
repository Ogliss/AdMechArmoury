      <PsychicSensitivity>2</PsychicSensitivity>
      <Beauty>1</Beauty>
      <Beauty>2</Beauty>
    </agreeableTraits>
    <disagreeableTraits>
      <PsychicSensitivity>-1</PsychicSensitivity>
      <PsychicSensitivity>-2</PsychicSensitivity>
      <Beauty>-1</Beauty>
      <Beauty>-2</Beauty>
    </disagreeableTraits>
</MemeDef>

<MemeDef ParentName="OG_Structure_MemeBase">
    <defName>OG_Structure_Aeldari_Drukhari</defName>
    <label>dark eldar</label>
    <description>The Drukhari are the epitome of the fallen Eldar race, thriving in the Dark City of Commorragh. They sustain their immortality and power through the suffering and torment of others. Their society is built on cruelty, deceit, and a hierarchical system where only the most cunning and ruthless survive. They shun psychic abilities, fearing the gaze of Slaanesh, and rely on advanced technology and sadistic practices to dominate and control.</description>
    <category>Structure</category>
    <iconPath>Ui/Memes/Structure/DarkEldar</iconPath>
    <impact>0</impact>
    <deityCount>0</deityCount>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->Drukhari</li>
        <li>memeHyphenPrefix->Dark</li>
        <li>memeLeaderNoun->Archon</li>
        <li>memeLeaderAdjective->Cunning</li>
        <li>memeMoralist->Haemonculus</li>
        <li>memeMoralist->Sybarite</li>
        <li>memeShootingSpecialist->Kabalite</li>
        <li>memeMeleeSpecialist->Wych</li>
        <li>memeResearchSpecialist->Homunculus</li>
        <li>memePlantSpecialist->Splicer</li>
        <li>memeAnimalsSpecialist->Beastmaster</li>
        <li>memeProductionSpecialist->Artificer</li>
        <li>memeMiningSpecialist->Soul Harvester</li>
        <li>memeMedicalSpecialist->Torturer</li>
      </rulesStrings>
    </generalRules>
    <descriptionMaker>
      <patterns>
        <li><def>OG_Aeldari_Drukhari_Myth</def></li>
        <li><def>OG_Aeldari_Drukhari_Founder</def></li>
      </patterns>
      <constants>
        <li><key>og_structure_aeldari_drukhari</key><value>true</value></li>
      </constants>
    </descriptionMaker>
    <worshipRoomLabel>torture chamber</worshipRoomLabel>
    <symbolPacks>
      <li>
        <ideoName>Darkness</ideoName>
        <theme>shadow</theme>
        <adjective>shadowed</adjective>
        <member>shadow</member>
      </li>
      <li>
        <ideoName>Agony</ideoName>
        <theme>pain</theme>
        <adjective>agonizing</adjective>
        <member>torturer</member>
      </li>
      <li>
        <ideoName>Deceit</ideoName>
        <theme>deception</theme>
        <adjective>deceptive</adjective>
        <member>liar</member>
      </li>
    </symbolPacks>
    <preferredWeaponClasses>
      <noble>Ultratech</noble>
      <despised>Neolithic</despised>
    </preferredWeaponClasses>
    <!--requireOne>
      <li>
        <li>NoPsykers</li>
      </li>
    </requireOne-->
    <thingStyleCategories>
      <!--li>
        <category>Dark</category>
        <priority>4</priority>
      </li-->
    </thingStyleCategories>
    <agreeableTraits>
      <Psychopath>0</Psychopath>
      <SpeedOffset>1</SpeedOffset>
    </agreeableTraits>
    <disagreeableTraits>
      <Kind>0</Kind>
      <SpeedOffset>-1</SpeedOffset>
    </disagreeableTraits>
</MemeDef>


