<RulePackDef>
  <defName>OG_FestivalNamer_TauEmpire</defName>
  <rulePack>
    <rulesStrings>
      <!-- Festival Name Patterns -->
      <li>festivalName(p=2)->[techAdjective] [festival]</li>
      <li>festivalName->[festival] of [greaterGoodConcept]</li>
      <li>festivalName->[casteAdjective] [festival]</li>
      <li>festivalName->[ethereal]'s [festival]</li>
      <li>festivalName->[festival] of [ethereal]</li>
      <li>festivalName->[festival] of [casteConcept]</li>

      <!-- Festival Synonyms -->
      <li>festival->festival</li>
      <li>festival->celebration</li>
      <li>festival->gathering</li>
      <li>festival->conclave</li>
      <li>festival->jubilee</li>

      <!-- Adjectives and Themes -->
      <li>techAdjective->Tech</li>
      <li>techAdjective->Advanced</li>
      <li>techAdjective->Efficient</li>
      <li>casteAdjective->Fire</li>
      <li>casteAdjective->Earth</li>
      <li>casteAdjective->Air</li>
      <li>casteAdjective->Water</li>

      <!-- Ethereal and Concepts -->
      <li>ethereal->Aun'va</li>
      <li>ethereal->Aun'Shi</li>
      <li>ethereal->Shadowsun</li>

      <!-- Greater Good and Caste Concepts -->
      <li>greaterGoodConcept->Unity</li>
      <li>greaterGoodConcept->Progress</li>
      <li>greaterGoodConcept->Enlightenment</li>
      <li>casteConcept->Honor</li>
      <li>casteConcept->Service</li>
      <li>casteConcept->Duty</li>
    </rulesStrings>
  </rulePack>
</RulePackDef>

<RulePackDef>
  <defName>OG_LeaderTitleMaker_TauEmpire</defName>
