  </include>
  <rulePack>
    <rulesStrings>
      <!-- Leader Title Patterns -->
      <li>r_leaderTitle(p=6)->[casteAdjective] [tauTitle]</li>
      <li>r_leaderTitle(p=3)->[techAdjective] [tauTitle]</li>
      <li>r_leaderTitle(p=1)->[casteAdjective] [tauNoun]</li>
      <li>r_leaderTitle(p=1)->[tauNoun]</li>

      <!-- Adjectives -->
      <li>casteAdjective->Fire</li>
      <li>casteAdjective->Earth</li>
      <li>casteAdjective->Air</li>
      <li>casteAdjective->Water</li>
      <li>techAdjective->Tech</li>
      <li>techAdjective->Advanced</li>

      <!-- Titles and Nouns -->
      <li>tauTitle->Commander</li>
      <li>tauTitle->Ethereal</li>
      <li>tauTitle->Shas'O</li>
      <li>tauTitle->Por'O</li>
      <li>tauNoun->Leader</li>
      <li>tauNoun->Master</li>
      <li>tauNoun->Chief</li>
    </rulesStrings>
  </rulePack>
</RulePackDef>

