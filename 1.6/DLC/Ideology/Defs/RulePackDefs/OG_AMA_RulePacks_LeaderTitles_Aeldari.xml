<RulePackDef>
  <defName>OG_LeaderTitleMaker_Aeldari_Asuryani</defName>
  <include>
    <li MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_GlobalStructure</li>
  </include>
  <rulePack>
    <rulesStrings>
      <!-- Title Patterns -->
      <li>r_leaderTitle(p=6)->[ancientAdjective] [asuryaniNoun]</li>
      <li>r_leaderTitle(p=3)->[craftworldAdjective] [asuryaniNoun]</li>
      <li>r_leaderTitle(p=1)->[ancientAdjective] [craftworldNoun]</li>
      <li>r_leaderTitle(p=1)->[craftworldTitle]</li>
      
      <!-- Adjectives and Nouns -->
      <li>ancientAdjective->Ancient</li>
      <li>ancientAdjective->Mystic</li>
      <li>ancientAdjective->Eternal</li>
      <li>ancientAdjective->Celestial</li>
      <li>craftworldAdjective->High</li>
