      <li>asuryaniNoun->Seer</li>
      <li>asuryaniNoun->Warlock</li>
      <li>craftworldNoun->Councilor</li>
      <li>craftworldNoun->Elder</li>
      <li>craftworldNoun->Leader</li>
      <li>craftworldNoun->Warden</li>
    </rulesStrings>
  </rulePack>
</RulePackDef>

